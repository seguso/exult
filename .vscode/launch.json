                "${workspaceFolder}/.vscode/exult-launch.cfg",
                "--fov"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false
        },
        {
            "name": "Launch Exult (Serpent Isle)",
